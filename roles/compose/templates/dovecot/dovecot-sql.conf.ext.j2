sql_driver = mysql
mysql mysql_mail {
  dbname = mailserver
  user = {{ mysql_mail_user | to_json }}
  password = {{ mysql_mail_password | to_json }}
}

passdb sql {
  default_password_scheme = MD5-CRYPT
  query = SELECT username AS user,password FROM mailbox WHERE username = '%{user}' AND active='1'
}

userdb sql {
  query = SELECT CONCAT('/srv/mail/', maildir) AS home, {{ vmail_user_id }} AS uid, {{ mail_group_id }} AS gid, CONCAT(quota, 'B') AS quota_storage_size FROM mailbox WHERE username = '%{user}' AND active='1'
  iterate_query = SELECT username AS user FROM mailbox WHERE active='1'
}
